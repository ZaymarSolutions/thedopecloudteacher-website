# Server Configuration
PORT=3000
NODE_ENV=production

# JWT Secret (generate a random secret key)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Stripe Keys (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# DCT merch (keep disabled until print placements, samples, and payments are tested)
MERCH_CHECKOUT_ENABLED=false
PRINTIFY_SHOP_ID=29102601
PRINTIFY_API_TOKEN=
# Existing Printify product ID and variant ID for each size. The set combines
# the hoodie and joggers; no separate Printify set product is required.
MERCH_PRODUCTS_JSON={"hoodie":{"product_id":"","variants":{"S":0,"M":0,"L":0,"XL":0,"2XL":0}},"tee":{"product_id":"","variants":{"S":0,"M":0,"L":0,"XL":0,"2XL":0}},"joggers":{"product_id":"","variants":{"S":0,"M":0,"L":0,"XL":0,"2XL":0}}}

# Database
DATABASE_PATH=./database.sqlite

# Frontend URL
FRONTEND_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080

# AI Assistant
# Use one of OPENAI_API_KEY or AI_API_KEY
OPENAI_API_KEY=
AI_API_KEY=
AI_API_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Admin Email (for notifications)
ADMIN_EMAIL=thedopecloudteacher@gmail.com

# Email Configuration (Gmail or any SMTP provider)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=your-email@gmail.com

# Lead capture webhook (optional - Zapier/ConvertKit/Mailchimp)
# If not set, emails will be sent directly
LEAD_WEBHOOK_URL=

# Storefront fallback
GUMROAD_STORE_URL=https://roseecraft.gumroad.com

# Optional external platform keys (keep server-side only)
BEAUTIFUL_AI_API_KEY=
CANVA_API_KEY=
CLAUDE_API_KEY=
MANUS_API_KEY=
